# Google Gemini API key (create at https://aistudio.google.com/apikey).
# Used ONLY for generation; embeddings are local and need no key.
GEMINI_API_KEY=your-key-here

# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodsafety

# Set REPLAY=1 to serve captured fixture answers with no key / no DB (class fallback)
# REPLAY=1
