# The default "course" adapter uses any OpenAI Chat Completions-compatible API:
# the course endpoint, a local server (LM Studio, Ollama, vLLM), or OpenAI itself.
# Used ONLY for generation; embeddings are local and need no endpoint.
LLM_PROVIDER=course
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-key-here

# A local model server instead - no key needed, model name as the server lists it:
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=qwen2.5-7b-instruct

# Optional provider comparisons use their own normal credentials and model IDs:
# LLM_PROVIDER=openai       # OPENAI_API_KEY
# LLM_PROVIDER=anthropic    # ANTHROPIC_API_KEY
# LLM_PROVIDER=google-cloud # Google Cloud application-default credentials

# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodsafety

# Set REPLAY=1 to serve captured fixture answers with no key / no DB (class fallback)
# REPLAY=1
