# The LLM endpoint. Any OpenAI-compatible server works: the course-provided
# endpoint, a local model server (LM Studio, Ollama, vLLM), or api.openai.com.
# Used ONLY for generation; embeddings are local and need no endpoint.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-key-here

# A local model server instead - no key needed, model name as the server lists it:
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=qwen2.5-7b-instruct

# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodsafety

# Set REPLAY=1 to serve captured fixture answers with no key / no DB (class fallback)
# REPLAY=1
